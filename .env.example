# SKYLONZE backend env — copy to .env.local and fill
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=skylonze
DB_PORT=3306

JWT_SECRET=
SESSION_COOKIE=sky_session
ADMIN_COOKIE=sky_admin

ADMIN_EMAIL=admin@skylonze.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=SKYLONZE Admin

SIGNUP_BONUS=500

APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SKYLONZE <no-reply@skylonze.com>

# AI assistant (NOVA chatbot). Optional:
# - Leave blank to use the built-in knowledge-based responder (no cost, works offline).
# - Set ANTHROPIC_API_KEY to have replies generated by Claude.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-4-5-20251001

# Anti-bot signup protection. Honeypot + timing + per-IP rate limiting are always on.
# For strong protection against automated sign-ups, enable Cloudflare Turnstile (free):
# create a widget at https://dash.cloudflare.com/?to=/:account/turnstile and paste both keys.
# Leave blank to keep Turnstile disabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
